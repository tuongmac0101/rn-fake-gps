{
  "name": "gps-fake-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "p": "sh push-git.sh",
    "postinstall": "patch-package",
    "dev": "NODE_ENV=development && expo start --dev-client",
    "sta": "NODE_ENV=test && expo start --dev-client",
    "production": "NODE_ENV=production expo start --dev-client ",
    "prebuild:dev:ios": "NODE_ENV=development expo prebuild --platform ios",
    "prebuild:sta:ios": "NODE_ENV=test expo prebuild --platform ios",
    "prebuild:prod:ios": "NODE_ENV=production expo prebuild --platform ios",
    "prebuild:dev:android": "NODE_ENV=development expo prebuild --platform android",
    "prebuild:sta:android": "NODE_ENV=test expo prebuild --platform android",
    "prebuild:prod:android": "NODE_ENV=production expo prebuild --platform android",
    "local:dev:ios": "NODE_ENV=development expo run:ios --scheme ApetechsDEV",
    "local:sta:ios": "NODE_ENV=test expo run:ios --scheme ApetechsDEV",
    "local:prod:ios": "NODE_ENV=production expo run:ios --scheme ApetechsDEV",
    "local:dev:android": "NODE_ENV=development expo run:android",
    "local:sta:android": "NODE_ENV=test expo run:android",
    "local:prod:android": "NODE_ENV=production expo run:android",
    "ota:dev": "bun run pre-ota && APP_ENV=development eas update --clear-cache --branch development",
    "ota:preview": "bun run pre-ota && APP_ENV=preview eas update --clear-cache --branch preview",
    "ota:prod": "bun run pre-ota && APP_ENV=production eas update --clear-cache --branch production",
    "ota:release": "bun run pre-ota && APP_ENV=release eas update --clear-cache --branch release",
    "ota:apk-release": "bun run pre-ota && APP_ENV=release eas update --clear-cache --branch apk-release",
    "build:ios:dev": "APP_ENV=development eas build --profile development --platform ios --clear-cache --no-wait",
    "build:android:dev": "APP_ENV=development eas build --profile development --platform android --clear-cache --no-wait",
    "build:ios:preview": "APP_ENV=preview eas build --profile preview --platform ios --clear-cache --no-wait",
    "build:android:preview": "APP_ENV=preview eas build --profile preview --platform android --clear-cache --no-wait",
    "build:ios:prod": "APP_ENV=production eas build --profile production --platform ios --clear-cache --no-wait",
    "build:android:prod": "APP_ENV=production eas build --profile production --platform android --clear-cache --no-wait",
    "build:ios:release": "APP_ENV=release eas build --profile release --platform ios --clear-cache --no-wait",
    "build:android:release": "APP_ENV=release eas build --profile release --platform android --clear-cache --no-wait",
    "build:android:apk-release": "APP_ENV=release eas build --profile apk-release --platform android --clear-cache --no-wait",
    "submit:ios:preview": "APP_ENV=preview eas submit --profile preview --platform ios --no-wait",
    "submit:android:preview": "APP_ENV=preview eas submit --profile preview --platform android --no-wait",
    "submit:ios:prod": "APP_ENV=production eas submit --profile production --platform ios --no-wait",
    "submit:android:prod": "APP_ENV=production eas submit --profile production --platform android --no-wait",
    "submit:ios:release": "APP_ENV=release eas submit --profile release --platform ios --no-wait",
    "submit:android:release": "APP_ENV=release eas submit --profile release --platform android --no-wait",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.3.1",
    "@eva-design/eva": "^2.2.0",
    "@gorhom/bottom-sheet": "^5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "4.5.6",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@shopify/flash-list": "1.7.6",
    "@tanstack/react-query": "^5.86.0",
    "@ui-kitten/components": "^5.3.1",
    "@ui-kitten/eva-icons": "^5.3.1",
    "axios": "^1.11.0",
    "dayjs": "^1.11.19",
    "expo": "^53.0.20",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-image-picker": "^17.0.10",
    "expo-localization": "~16.1.6",
    "expo-location": "~18.1.6",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.17",
    "formik": "^2.4.6",
    "geolib": "^3.3.4",
    "i18next": "^25.4.2",
    "lucide-react-native": "^0.577.0",
    "react": "19.0.0",
    "react-i18next": "^15.7.2",
    "react-native": "0.79.5",
    "react-native-android-mock-location": "^4.3.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "rn-expo-google-places-autocomplete": "^1.1.2",
    "yup": "^1.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3"
  },
  "private": true
}
